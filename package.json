    "data:verify-supabase-ticket03": "node --env-file=.env --import tsx scripts/verify-supabase-ticket03.ts",
    "data:verify-supabase-ticket04": "node --env-file=.env --import tsx scripts/verify-supabase-ticket04.ts",
    "data:probe-supabase-ticket04-api": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/probe-supabase-ticket04-api.ts",
