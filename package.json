    "data:migrate-invoice-discounts": "node --env-file=.env --import tsx scripts/migrate-invoice-discounts.ts",
    "data:rescue-insforge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/rescue-insforge.ts --rescue",
    "data:verify-insforge-rescue": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env --experimental-strip-types scripts/rescue-insforge.ts --verify",
