# App runtime
# Required. Public InsForge project URL used by browser and server clients.
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.ap-southeast.insforge.app

# Required. Public InsForge anonymous key used by the app client.
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-public-anon-key

# Required. Server-only InsForge API key for privileged backend operations.
INSFORGE_API_KEY=your-server-only-project-api-key

# Optional. App base URL used by local scripts; defaults to http://localhost:3000 where supported.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API timing logs
# Optional. In production, set true to enable [api-timing] console logs. Development logs are enabled by default.
API_TIMING_LOG_ENABLED=false

# API performance baseline: used only by npm run perf:api-baseline
# Required for a valid authenticated baseline. Copy the full browser Cookie header from a signed-in request.
# Secret. Do not commit a real cookie value.
NEXT_API_BASELINE_COOKIE="<copy browser Cookie header>"

# Optional. Target app URL for the baseline script. Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000.
API_BASELINE_BASE_URL=http://localhost:3000

# Optional. Number of warm samples per endpoint; default is 5.
API_BASELINE_SAMPLES=5

# Optional. Output JSON path; default is .scratch/performance/api-baseline-latest.json.
API_BASELINE_OUTPUT=.scratch/performance/api-baseline-latest.json

# Optional. Existing baseline JSON to compare against the new run.
API_BASELINE_BEFORE=

# Optional. Allows an intentional unauthenticated 401 auth check. Keep false for real performance baselines.
API_BASELINE_ALLOW_UNAUTHENTICATED=false

# Optional. Manual Server Action durations for invoice generation: cold first, then warm samples.
# Example: 520.1,310.4,298.7,305.2,299.9,301.0
API_BASELINE_INVOICE_GENERATION_SAMPLES=
