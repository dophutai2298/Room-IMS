# App runtime
# Optional during migration. Defaults to insforge. Set only on an isolated
# Supabase deployment after its schema, Auth mapping and RLS tests pass.
APP_BACKEND=insforge

# Required when APP_BACKEND=supabase. Both are public client configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Required for server-side Supabase Staff provisioning, recovery and import.
# Secret: never prefix NEXT_PUBLIC_ or expose in browser bundles.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Migration-only PostgreSQL connection string. Never needed for app runtime.
# Use Direct, or Session pooler if your machine cannot reach the IPv6 direct endpoint.
# Replace the database password placeholder and URL-encode special characters.
SUPABASE_DB_URL=postgresql://postgres:your-url-encoded-password@db.your-project-ref.supabase.co:5432/postgres

# Required. Public InsForge project URL used by browser and server clients.
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.ap-southeast.insforge.app

# Required. Public InsForge anonymous key used by the app client.
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-public-anon-key

# Required. Server-only InsForge API key for privileged backend operations.
INSFORGE_API_KEY=your-server-only-project-api-key

# Optional. App base URL used by local scripts; defaults to http://localhost:3000 where supported.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API timing logs
# Optional. In production, set true to enable [api-timing] console logs. Development logs are enabled by default.
API_TIMING_LOG_ENABLED=false

# API performance baseline: used only by npm run perf:api-baseline
# Required for a valid authenticated baseline. Copy the full browser Cookie header from a signed-in request.
# Secret. Do not commit a real cookie value.
NEXT_API_BASELINE_COOKIE="<copy browser Cookie header>"

# Optional. Target app URL for the baseline script. Falls back to NEXT_PUBLIC_APP_URL, then http://localhost:3000.
API_BASELINE_BASE_URL=http://localhost:3000

# Optional. Number of warm samples per endpoint; default is 5.
API_BASELINE_SAMPLES=5

# Optional. Output JSON path; default is .scratch/performance/api-baseline-latest.json.
API_BASELINE_OUTPUT=.scratch/performance/api-baseline-latest.json

# Optional. Existing baseline JSON to compare against the new run.
API_BASELINE_BEFORE=

# Optional. Allows an intentional unauthenticated 401 auth check. Keep false for real performance baselines.
API_BASELINE_ALLOW_UNAUTHENTICATED=false

# Optional. Manual Server Action durations for invoice generation: cold first, then warm samples.
# Example: 520.1,310.4,298.7,305.2,299.9,301.0
API_BASELINE_INVOICE_GENERATION_SAMPLES=

# Rental billing import/backfill
# Required only when running npm run data:import-rental-billing or npm run data:migrate-account-scope.
# The landlord app_users.id that should own imported/backfilled business data.
# New records created in the app ignore this value and use the signed-in account scope.
IMPORT_OWNER_APP_USER_ID=your-landlord-app-user-id

# InsForge rescue backup (not needed for normal app runtime)
# Required only for data:rescue-insforge, data:verify-insforge-rescue and --extract.
# Set a private passphrase of at least 20 characters. Do not commit the actual value.
RESCUE_BACKUP_PASSPHRASE=

# Optional. Comma-separated hostnames for reachable legacy CCCD image URLs outside the project host.
RESCUE_EXTRA_ASSET_HOSTS=

# Do not keep RESCUE_ALLOW_PLAINTEXT_RESTORE=true in .env. Set it temporarily
# only when extracting into a protected, disposable directory.
